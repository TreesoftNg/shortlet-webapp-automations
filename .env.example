# Guest site (shortlet-frontend)
CUSTOMER_BASE_URL=http://localhost:3000

# Admin console (shortlet-admin) — use a free port if customer already owns 3000
ADMIN_BASE_URL=http://localhost:3001

# Demo owner (seeded via shortlet-api demo seed)
ADMIN_EMAIL=demo.owner@example.com
ADMIN_PASSWORD=Sunmade-Demo-2026!

# Optional: seeded guest for auth specs
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# Optional: known property slug for book/pay specs
PROPERTY_SLUG=

# Tenant (apps also need NEXT_PUBLIC_TENANT_SLUG=sunmade when talking to local API)
TENANT_SLUG=sunmade
