# Guest site (shortlet-frontend). Live customer app:
CUSTOMER_BASE_URL=https://shortlet-frontend-eta.vercel.app
# Local alternative: http://localhost:3000

# Admin console (shortlet-admin). Live admin app:
ADMIN_BASE_URL=https://shortlet-admin-lyart.vercel.app
# Local alternative: http://localhost:3001

# Admin owner for admin specs (required for authenticated admin tests)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Verified guest for sign-in, booking, and Paystack pay specs.
# Account creation stops at the email code, so this guest must already be verified.
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=

# Optional: known property slug for book/pay specs
PROPERTY_SLUG=

# Tenant (apps also need NEXT_PUBLIC_TENANT_SLUG=sunmade when talking to local API)
TENANT_SLUG=sunmade
